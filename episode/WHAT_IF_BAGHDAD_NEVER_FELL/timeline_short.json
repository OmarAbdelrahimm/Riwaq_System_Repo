{
 "duration_s": 53.555,
 "beats": [
  {
   "i": 0,
   "text": "العاشر من فبراير، ألفٍ ومئتين وثمانٍ وخمسين.",
   "vo_in": 0.3,
   "vo_out": 3.69,
   "t_in": 0.0,
   "t_out": 4.07
  },
  {
   "i": 1,
   "text": "آخر خلفاء بغداد يخرج ليُسلّم مدينته لهُولَاكُو.",
   "vo_in": 4.45,
   "vo_out": 7.42,
   "t_in": 4.07,
   "t_out": 7.6
  },
  {
   "i": 2,
   "text": "لكن قبلها بعام، كان أمامه خيار: أن يخضع، فينجو.",
   "vo_in": 7.78,
   "vo_out": 12.2,
   "t_in": 7.6,
   "t_out": 12.315
  },
  {
   "i": 3,
   "text": "الحِلّة والكوفة والبصرة خضعت… فنجت.",
   "vo_in": 12.43,
   "vo_out": 16.13,
   "t_in": 12.315,
   "t_out": 16.505
  },
  {
   "i": 4,
   "text": "فماذا لو قبل؟",
   "vo_in": 16.88,
   "vo_out": 17.72,
   "t_in": 16.505,
   "t_out": 18.0
  },
  {
   "i": 5,
   "text": "هذا خيالٌ تاريخي، مبنيٌّ على المصادر.",
   "vo_in": 18.28,
   "vo_out": 20.72,
   "t_in": 18.0,
   "t_out": 20.91
  },
  {
   "i": 6,
   "text": "تنجو بغداد، وأهلها، ومكتباتها.",
   "vo_in": 21.1,
   "vo_out": 23.8,
   "t_in": 20.91,
   "t_out": 24.11
  },
  {
   "i": 7,
   "text": "لكن الخليفة يصبح تابعًا للمغول: يمنح الشرعية… بلا قرار.",
   "vo_in": 24.42,
   "vo_out": 29.49,
   "t_in": 24.11,
   "t_out": 29.655
  },
  {
   "i": 8,
   "text": "ثم تأتي المفاجأة: في ألفٍ ومئتين وتسعٍ وخمسين يموت الخان الأعظم مُونْكُو، ويسحب هولاكو جيشه من الشام في كل الأحوال.",
   "vo_in": 29.82,
   "vo_out": 38.25,
   "t_in": 29.655,
   "t_out": 38.52
  },
  {
   "i": 9,
   "text": "وفي عين جالوت ينتصر المماليك… في العالمين.",
   "vo_in": 38.79,
   "vo_out": 42.34,
   "t_in": 38.52,
   "t_out": 42.72
  },
  {
   "i": 10,
   "text": "الفرق الحقيقي؟",
   "vo_in": 43.1,
   "vo_out": 44.0,
   "t_in": 42.72,
   "t_out": 44.165
  },
  {
   "i": 11,
   "text": "لا يجد بيبرس خليفةً لاجئًا ينصّبه في القاهرة.",
   "vo_in": 44.33,
   "vo_out": 46.95,
   "t_in": 44.165,
   "t_out": 47.145
  },
  {
   "i": 12,
   "text": "فهل كانت بغداد ستنجو… أم الفكرة؟",
   "vo_in": 47.34,
   "vo_out": 49.81,
   "t_in": 47.145,
   "t_out": 50.145
  },
  {
   "i": 13,
   "text": "القصة كاملة على رِواق.",
   "vo_in": 50.48,
   "vo_out": 51.955,
   "t_in": 50.145,
   "t_out": 53.555
  }
 ],
