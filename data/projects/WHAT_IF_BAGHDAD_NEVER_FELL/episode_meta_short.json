  "data": [
   {
    "t_in": 0.22,
    "t_out": 3.94,
    "ar": "العاشر من فبراير، ألفٍ\nومئتين وثمانٍ وخمسين.",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 4.37,
    "t_out": 7.66,
    "ar": "آخر خلفاء بغداد يخرج ليُسلّم\nمدينته لهُولَاكُو.",
    "en": "",
    "keywords": [
     "بغداد"
    ]
   },
   {
    "t_in": 7.7,
    "t_out": 12.31,
    "ar": "لكن قبلها بعام، كان أمامه\nخيار: أن يخضع، فينجو.",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 12.35,
    "t_out": 17.97,
    "ar": "الحِلّة والكوفة والبصرة\nخضعت… فنجت. فماذا لو قبل؟",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 18.2,
    "t_out": 20.97,
    "ar": "هذا خيالٌ تاريخي، مبنيٌّ على\nالمصادر.",
    "en": "",
    "keywords": [
     "خيال"
    ]
   },
   {
    "t_in": 21.02,
    "t_out": 24.05,
    "ar": "تنجو بغداد، وأهلها،\nومكتباتها.",
    "en": "",
    "keywords": [
     "بغداد"
    ]
   },
   {
    "t_in": 24.34,
    "t_out": 28.7,
    "ar": "لكن الخليفة يصبح تابعًا\nللمغول: يمنح الشرعية…",
    "en": "",
    "keywords": [
     "الخليفة",
     "الشرعية"
    ]
   },
   {
    "t_in": 28.74,
    "t_out": 29.7,
    "ar": "بلا قرار.",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 29.74,
    "t_out": 32.661,
    "ar": "ثم تأتي المفاجأة: في ألفٍ\nومئتين وتسعٍ",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 32.701,
    "t_out": 35.071,
    "ar": "وخمسين يموت الخان الأعظم\nمُونْكُو،",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 35.111,
    "t_out": 38.5,
    "ar": "ويسحب هولاكو جيشه من الشام\nفي كل الأحوال.",
    "en": "",
    "keywords": [
     "هولاكو"
    ]
   },
   {
    "t_in": 38.71,
    "t_out": 42.59,
    "ar": "وفي عين جالوت ينتصر\nالمماليك… في العالمين.",
    "en": "",
    "keywords": [
     "عين جالوت"
    ]
   },
   {
    "t_in": 43.01,
    "t_out": 44.21,
    "ar": "الفرق الحقيقي؟",
    "en": "",
    "keywords": []
   },
   {
    "t_in": 44.25,
    "t_out": 47.2,
    "ar": "لا يجد بيبرس خليفةً لاجئًا\nينصّبه في القاهرة.",
    "en": "",
    "keywords": []
   },
   {
