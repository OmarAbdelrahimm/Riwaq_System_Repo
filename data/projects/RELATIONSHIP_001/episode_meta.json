      },
      {
        "t_in": 37.211,
        "t_out": 43.371,
        "ar": "لقاء الكاشير والعميل مثالٌ على التعامل العابر.",
        "keywords": []
      },
      {
        "t_in": 43.371,
        "t_out": 49.731,
        "ar": "هذه مهارات اتصال تدير الموقف؛ لكن العلاقات أعمق.",
        "keywords": []
      },
      {
        "t_in": 49.731,
        "t_out": 57.531,
        "ar": "والأمر الآخر أننا نخلط بين مهارات الاتصال والعلاقات.",
        "keywords": []
      },
      {
        "t_in": 57.531,
        "t_out": 63.691,
        "ar": "نعتقد أحيانًا أن العلاقة هي أنا وأنت فقط.",
        "keywords": []
      },
      {
        "t_in": 63.691,
        "t_out": 72.371,
        "ar": "أنا وأنت؛ تكرار اللقاءات يصنع العلاقة.",
        "keywords": []
      },
      {
        "t_in": 72.371,
        "t_out": 80.971,
        "ar": "كثرة التواصل العابر قد تنقل العلاقة إلى مستوى آخر.",
        "keywords": []
      },
      {
        "t_in": 80.971,
        "t_out": 87.811,
        "ar": "مثال بسيط: أنا الآن مع المضيف في الطائرة.",
        "keywords": []
      },
      {
        "t_in": 87.811,
        "t_out": 92.931,
        "ar": "في اللقاء الأول، مع كل واحد قلم وورقة.",
        "keywords": []
      },
      {
        "t_in": 92.931,
        "t_out": 99.851,
        "ar": "يقول: السلام عليكم، فيرسم شيئًا في ورقته، وأنا أردّ عليه بالرسم.",
        "keywords": []
      },
      {
        "t_in": 99.851,
        "t_out": 107.571,
        "ar": "في كل تواصل نكمل رسم اللوحة؛ لوحتنا نكملها معًا.",
        "keywords": []
      },
      {
        "t_in": 107.571,
        "t_out": 117.851,
        "ar": "وفي رحلة أخرى، بعد سنوات أو أشهر، ألقاه ونكمل الرسم من حيث توقفنا.",
        "keywords": []
      },
      {
        "t_in": 117.851,
        "t_out": 128.771,
        "ar": "ولو لم يردّ بطريقة جيدة، أو لم أحتفِ به، فقد أقرر ألا أكمل الرسم.",
        "keywords": []
      },
      {
        "t_in": 128.771,
        "t_out": 135.891,
        "ar": "هنا تتمزق الورقة، وتنتهي العلاقة.",
