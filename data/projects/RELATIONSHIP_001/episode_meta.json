      {
        "t_in": 135.891,
        "t_out": 140.971,
        "ar": "بطبيعتها، العلاقة ليست شخصين فقط؛ بل تتكوّن من خمسة أشياء.",
        "keywords": []
      },
      {
        "t_in": 140.971,
        "t_out": 150.651,
        "ar": "إذا كنا اثنين، فبيننا خمسة عناصر: ألف، باء...",
        "keywords": []
      },
      {
        "t_in": 150.651,
        "t_out": 157.371,
        "ar": "جيم: ما يصدر مني؛ ودال: ما يصدر منك.",
        "keywords": []
      },
      {
        "t_in": 157.371,
        "t_out": 166.411,
        "ar": "ثم استجابتنا لهذا. هذا النموذج البسيط يفسّر كثيرًا من الأسئلة.",
        "keywords": []
      },
      {
        "t_in": 166.411,
        "t_out": 171.371,
        "ar": "لماذا ينفصل زوجان، مع أن كليهما طيب؟",
        "keywords": []
      },
      {
        "t_in": 171.371,
        "t_out": 178.651,
        "ar": "قد يتمنى كلٌّ منهما الآخر، لكن...",
        "keywords": []
      },
      {
        "t_in": 178.651,
        "t_out": 184.291,
        "ar": "ما يصدر من أحدهما تجاه الآخر قد لا يكون جيدًا.",
        "keywords": []
      },
      {
        "t_in": 184.291,
        "t_out": 191.051,
        "ar": "قد أكون إنسانًا راقيًا، لكن أسلوبي معك فيه مشكلة؛ وربما العكس.",
        "keywords": []
      },
      {
        "t_in": 191.051,
        "t_out": 195.571,
        "ar": "وهنا تظهر استجابتنا.",
        "keywords": []
      },
      {
        "t_in": 195.571,
        "t_out": 204.451,
        "ar": "حين أرى أن عليك أن تحترمني، أطلب ذلك...",
        "keywords": []
      },
      {
        "t_in": 204.451,
        "t_out": 208.331,
        "ar": "وأنت ترى أنك تحترمني.",
        "keywords": []
      },
      {
        "t_in": 208.331,
        "t_out": 218.371,
        "ar": "هل ستقبل اعتراضي، أم ستراه تهديدًا لذاتك؟",
        "keywords": []
      },
      {
        "t_in": 218.371,
        "t_out": 227.211,
        "ar": "العلاقة ليست ألفًا أو باءً فقط؛ بل ألف وباء وجيم ودال.",
        "keywords": []
      },
      {
        "t_in": 227.211,
        "t_out": 232.891,
        "ar": "وتفسيراتنا لسلوكياتنا تدخل في الصورة.",
