      },
      {
        "t_in": 7.971,
        "t_out": 14.29,
        "ar": "أنا مهتم بالعلاقات منذ قرابة عشرين سنة.",
        "keywords": []
      },
      {
        "t_in": 14.29,
        "t_out": 18.13,
        "ar": "وأنا أحضر وأحاضر فيها.",
