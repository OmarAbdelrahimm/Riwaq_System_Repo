      {
        "t_in": 18.13,
        "t_out": 24.491,
        "ar": "ومن الأشياء التي تؤلمني أن يعتقد الإنسان...",
        "keywords": []
      },
      {
        "t_in": 24.491,
        "t_out": 28.651,
        "ar": "أن الابتسامة واللباس الحسن والأسلوب الجيد...",
        "keywords": []
      },
      {
        "t_in": 28.651,
        "t_out": 32.371,
        "ar": "تبني علاقة جيدة؟ لا، هذه مهارات اتصال.",
